# ── Secrets / environment ──────────────────────────────────────────────────
# API keys (Gemini, Groq, OpenRouter, Anthropic, OpenAI), local overrides.
# .env.* alone would also hide *.env.example — carve that back out explicitly
# so example/template env files stay versioned.
.env
.env.*
!.env.example
.env.local
.env.production

# ── Application data (100% local, personal) ─────────────────────────────────
# Everything under cortex-server/data/ : SQLite DB, LanceDB vectors, uploaded
# images, backups, watched inbox, imported corpus, uploaded/processed files,
# temp audio/video from transcription — all personal, never versioned.
cortex-server/data/

# ── Test scratch DBs (recreated from scratch by the tests themselves via
# fs.rmSync + initSqlite on every run — never meant to hold real content) ───
cortex-server/data-test-*/

# ── TLS certificates (mobile/HTTPS dev mode) ─────────────────────────────────
certs/

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
cortex-server/bin/*.exe
cortex-server/node_modules/
docteur-voice/node_modules/

# ── Build output ──────────────────────────────────────────────────────────
dist/
build/
.vite/
coverage/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log

# ── Temp / cache ────────────────────────────────────────────────────────────
tmp/
.tmp/
.cache/
*.tmp

# ── Ad hoc E2E/manual-QA artifacts (neurons, agents, scripts created and
# cleaned up during a testing pass are prefixed this way — guards against one
# being committed by accident if cleanup is missed) ──────────────────────────
__E2E_TEST__*

# ── OS junk ─────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store

# ── Claude Code project settings (local machine, not shared) ───────────────
.claude/
