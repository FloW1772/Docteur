{
  "name": "docteur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test:external-agents": "node scripts/test-external-agents-browser.mjs",
    "test:video": "node --test scripts/test-video-polling.mjs",
    "test:browser": "node scripts/test-frontend-browser.mjs",
    "test:article-capture": "node --test scripts/test-article-capture-pipeline.mjs",
    "test:article-capture-browser": "node scripts/test-article-capture-browser.mjs",
    "test:audit": "node --experimental-test-module-mocks --test scripts/test-audit-storage.mjs scripts/test-audit-runtime.mjs scripts/test-feature-registry.mjs scripts/test-video-polling.mjs scripts/test-dashboard-layout-unit.mjs scripts/test-kg-graph-unit.mjs",
    "test:review": "node --test scripts/test-final-review-lan.mjs && node scripts/test-final-review-browser.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "dev:local": "cross-env LOCAL_NETWORK=true vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:mobile": "cross-env LOCAL_NETWORK=true vite preview --host --port 5173",
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs && node scripts/copy-tesseract-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
