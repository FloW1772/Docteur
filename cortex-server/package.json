{
  "name": "cortex-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:external-agents": "node --test --test-timeout=20000 test-external-agents.mjs",
    "test:video": "node --experimental-test-module-mocks --test test-video-audio.mjs test-video-pipeline.mjs",
    "test:freellmapi": "node --test test-freellmapi.mjs",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:local": "cross-env LOCAL_NETWORK=true nodemon src/server.js",
    "check": "node src/server.js --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@lancedb/lancedb": "^0.30.0",
    "@mozilla/readability": "^0.6.0",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "hono": "^4.13.7",
    "jsdom": "^29.1.1",
    "marked": "^18.0.9",
    "node-7z": "^3.0.0",
    "ollama": "^0.5.16",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "playwright": "^1.61.1",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.9"
  }
}
