{
  "name": "cortex-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:external-agents": "node --test --test-timeout=20000 test-external-agents.mjs",
    "test:video": "node --experimental-test-module-mocks --test test-video-audio.mjs test-video-pipeline.mjs",
    "test:freellmapi": "node --test test-freellmapi.mjs",
    "test:privacy": "node --test test-privacy-guard.mjs",
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-preserve-output src/server.js",
    "dev:local": "cross-env LOCAL_NETWORK=true node --watch-path=src --watch-preserve-output src/server.js",
    "test:audit": "node --experimental-test-module-mocks --test test-audit-persistence.mjs test-audit-lancedb.mjs test-audit-vector-integration.mjs test-audit-secret-transport.mjs test-nb7-local-api-security.mjs test-web-egress-guard.mjs test-rpc2a-secret-store-negative.mjs",
    "test:review": "node --test test-final-review-backup.mjs test-final-review-vectors.mjs",
    "check": "node src/server.js --check"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@lancedb/lancedb": "^0.30.0",
    "@mozilla/readability": "^0.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "hono": "^4.13.7",
    "ignore": "^7.0.9",
    "jsdom": "^29.1.1",
    "marked": "^18.0.9",
    "node-7z": "^3.0.0",
    "ollama": "^0.5.16",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "playwright": "^1.61.1",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
