PORT=3001
# HOST is overridden automatically when LOCAL_NETWORK=true (set to 0.0.0.0)
HOST=127.0.0.1
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
ANSWER_MODEL=llama3.2:3b
LANCEDB_PATH=./data/cortex.lance
SQLITE_PATH=./data/cortex.sqlite
LOG_LEVEL=info
LOG_FILE=./data/cortex.log
# Set to true to expose on the local Wi-Fi network (mobile access / PWA)
# NEVER enable on a machine directly reachable from the internet
LOCAL_NETWORK=false
# Optional third audio download attempt after HTTP 403 (chrome or firefox).
# Cookies stay in the backend process; no browser profile path is required.
VIDEO_YTDLP_BROWSER=
# Set LOG_LEVEL=debug for sanitized yt-dlp arguments and successful diagnostics.
